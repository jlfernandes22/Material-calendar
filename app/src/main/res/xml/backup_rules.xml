<?xml version="1.0" encoding="utf-8"?>
<!--
    Full backup rules (Android 8-11). The calendar database is excluded from
    automatic backups: privacy-first means the only backup is the explicit,
    user-controlled JSON / .ics export. Reminders are re-scheduled automatically
    on app start, so excluding the scheduler database is safe.
-->
<full-backup-content>
    <exclude domain="database" path="local_calendar_db" />
    <exclude domain="database" path="local_calendar_db-wal" />
    <exclude domain="database" path="local_calendar_db-shm" />
</full-backup-content>
